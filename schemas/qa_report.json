{
  "$defs": {
    "QAFinding": {
      "description": "A quality finding generated during QA checks.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "finding_id",
        "metric",
        "severity",
        "message"
      ],
      "title": "QAFinding",
      "type": "object"
    }
  },
  "description": "QA analysis report containing all findings.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_stage": {
      "title": "Producer Stage",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/QAFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "overall_passed": {
      "title": "Overall Passed",
      "type": "boolean"
    }
  },
  "required": [
    "producer_stage",
    "findings",
    "overall_passed"
  ],
  "title": "QAReport",
  "type": "object"
}