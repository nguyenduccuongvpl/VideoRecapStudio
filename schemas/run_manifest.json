{
  "$defs": {
    "CostRecord": {
      "description": "API usage cost log.",
      "properties": {
        "service_name": {
          "title": "Service Name",
          "type": "string"
        },
        "cost_usd": {
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "request_count": {
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "service_name",
        "cost_usd",
        "request_count",
        "input_tokens",
        "output_tokens"
      ],
      "title": "CostRecord",
      "type": "object"
    },
    "StageResult": {
      "description": "Execution status logs of a single pipeline stage.",
      "properties": {
        "stage_name": {
          "title": "Stage Name",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "title": "Completed At",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        }
      },
      "required": [
        "stage_name",
        "status",
        "started_at",
        "completed_at"
      ],
      "title": "StageResult",
      "type": "object"
    }
  },
  "description": "Complete logs manifest of a pipeline execution run.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_stage": {
      "title": "Producer Stage",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageResult"
      },
      "title": "Stages",
      "type": "array"
    },
    "costs": {
      "items": {
        "$ref": "#/$defs/CostRecord"
      },
      "title": "Costs",
      "type": "array"
    },
    "checksums": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Checksums",
      "type": "object"
    }
  },
  "required": [
    "producer_stage",
    "job_id",
    "started_at",
    "stages",
    "costs",
    "checksums"
  ],
  "title": "RunManifest",
  "type": "object"
}