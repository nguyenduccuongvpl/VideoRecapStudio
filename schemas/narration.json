{
  "$defs": {
    "NarrationClaim": {
      "description": "A factual claim stated in a narration segment.",
      "properties": {
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_time_ranges": {
          "items": {
            "$ref": "#/$defs/TimeRange"
          },
          "title": "Source Time Ranges",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "evidence_refs",
        "source_time_ranges"
      ],
      "title": "NarrationClaim",
      "type": "object"
    },
    "NarrationSegment": {
      "description": "A single segment of narration text with evidentiary grounding.",
      "properties": {
        "segment_id": {
          "minimum": 0,
          "title": "Segment Id",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/NarrationClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "segment_id",
        "text",
        "claims",
        "event_ids",
        "evidence_refs"
      ],
      "title": "NarrationSegment",
      "type": "object"
    },
    "TimeRange": {
      "description": "Represents a time range with start and end times in seconds.",
      "properties": {
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0.0,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "description": "Completed narration script containing grounded segments.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_stage": {
      "title": "Producer Stage",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/NarrationSegment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "producer_stage",
    "segments"
  ],
  "title": "Narration",
  "type": "object"
}